<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/nbg_pill"
    android:padding="0dp">

    <!-- 좌측 레드 액센트 (그라디언트) -->
    <FrameLayout
        android:id="@+id/accent"
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:background="@drawable/nbg_accent"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <!-- 앱/레코딩 아이콘 (선택) -->
        <ImageView
            android:id="@+id/icon_wave"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/cd_record"
            android:src="@drawable/ic_record_wave_24"
            app:tint="#FFFFFFFF" />
    </FrameLayout>

    <!-- 타이머/상태 -->
    <LinearLayout
        android:id="@+id/texts"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_toStartOf="@id/actions"
        android:layout_toEndOf="@id/accent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/feature_recording_status_recording"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 우측 액션 영역 -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- X (앱 종료/정지) -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/nbg_btn_circle_ripple"
            android:contentDescription="@string/cd_close"
            android:padding="8dp"
            android:src="@drawable/ic_close_24"
            app:tint="#FFFFFFFF" />

        <!-- 일시정지 -->
        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nbg_btn_circle_ripple"
            android:contentDescription="@string/cd_pause"
            android:padding="8dp"
            android:src="@drawable/ic_pause_24"
            app:tint="#FFFFFFFF" />

        <!-- 정지 -->
        <ImageButton
            android:id="@+id/btn_stop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nbg_btn_circle_ripple"
            android:contentDescription="@string/cd_stop"
            android:padding="8dp"
            android:src="@drawable/ic_stop_24"
            app:tint="#FFFFFFFF" />
    </LinearLayout>

</RelativeLayout>